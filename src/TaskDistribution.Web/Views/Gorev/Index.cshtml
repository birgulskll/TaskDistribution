@model List<TaskItem>
@{
    ViewData["Title"] = "Görevler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Görevler</h1>
        <small class="text-muted">Toplam @Model.Count görev · en yeni görev en üstte</small>
    </div>
    <a class="btn btn-primary" asp-action="Olustur">+ Yeni Görev</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz görev yok. <a asp-action="Olustur" class="alert-link">İlk görevi oluştur</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Başlık</th>
                    <th>İşlem</th>
                    <th>Zorluk</th>
                    <th>Atanan Personel</th>
                    <th>Oluşturma Tarihi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gorev in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@gorev.Baslik</div>
                            @if (!string.IsNullOrEmpty(gorev.Aciklama))
                            {
                                <div class="small text-muted">@gorev.Aciklama</div>
                            }
                        </td>
                        <td>@gorev.Islem.Ad</td>
                        <td><partial name="_ZorlukRozeti" model="gorev.Zorluk" /></td>
                        <td>@gorev.AtananPersonel.TamAd</td>
                        <td class="text-nowrap">@gorev.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
