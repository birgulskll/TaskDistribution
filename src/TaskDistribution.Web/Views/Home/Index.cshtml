@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="py-4">
    <h1 class="display-6">Task Distribution</h1>
    <p class="lead text-muted">
        Görevleri zorluk seviyelerine göre personellere otomatik ve adil şekilde dağıtan uygulama.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Personeller</h5>
                <p class="card-text text-muted">Personel ekle, düzenle, aktif veya pasif yap. Pasif personele görev atanmaz.</p>
                <a class="btn btn-primary" asp-controller="Personel" asp-action="Index">Personellere git</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">İşlemler</h5>
                <p class="card-text text-muted">Görev oluştururken seçilecek iş türleri ve zorluk seviyeleri.</p>
                <a class="btn btn-outline-primary" asp-controller="Islem" asp-action="Index">İşlemlere git</a>
            </div>
        </div>
    </div>
</div>
