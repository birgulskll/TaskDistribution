@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <h1 class="h3 text-danger">Beklenmeyen bir hata oluştu</h1>
    <p class="text-muted">İsteğin işlenirken bir sorun çıktı. Lütfen biraz sonra tekrar dene.</p>

    @* Hata kaydını (log) bulmayı kolaylaştıran takip numarası. Teknik detay kullanıcıya gösterilmez. *@
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Hata takip numarası: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Görev Dağılımına dön</a>
</div>
