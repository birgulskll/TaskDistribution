@* Controller'ın TempData'ya koyduğu mesajları renkli kutular olarak gösterir.
   TempData bir kez okununca silinir; sayfa yenilenince mesaj tekrar görünmez. *@

@if (TempData[Bildirim.Basari] is string basari)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @basari
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData[Bildirim.Uyari] is string uyari)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        ⚠️ @uyari
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData[Bildirim.Hata] is string hata)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ @hata
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
